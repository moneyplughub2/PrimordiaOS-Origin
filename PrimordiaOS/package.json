{
  "name": "primordiaos",
  "version": "4.0.0",
  "type": "module",
  "scripts": {
    "electron": "electron main.js",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:gateway": "wrangler dev cloudflare/workers/gateway/index.ts --config cloudflare/wrangler.toml",
    "dev:auth": "wrangler dev cloudflare/workers/auth/index.ts --config cloudflare/wrangler.toml",
    "dev:automation": "wrangler dev cloudflare/workers/automation/index.ts --config cloudflare/wrangler.toml",
    "dev:webhooks": "wrangler dev cloudflare/workers/webhooks/index.ts --config cloudflare/wrangler.toml",
